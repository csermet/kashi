# The live worker's non-secret pipeline settings, for audit.run_local:
#   docker run ... --env-file apps/server/audit/worker.env.example kashi-audit python -m audit.run_local ...
# Since pipeline 2.33.0 the first three values below ARE the code defaults (config.py,
# PRODUCTION_ALIGN_MODELS / PRODUCTION_SEPARATION_MODEL / structure_sections; tests/
# test_config_defaults pins them equal), so a run needs this file only for OMP_NUM_THREADS. They
# stay here, as in gitops, until gitops drops them; a value that differs in gitops still makes
# the live worker another pipeline (its ready line names the overridden field).
# docker --env-file takes every value literally: no quotes around the JSON.

ALIGN_MODELS={"eng":{"checkpoint":"jonatasgrosman/wav2vec2-xls-r-1b-english","offset_ms":-50,"offset_by_initial":{"vowel":-80,"fricative":-50,"plosive":-30,"sonorant":-20}},"tur":{"checkpoint":"mpoyraz/wav2vec2-xls-r-300m-cv7-turkish","romanize":false}}
STRUCTURE_SECTIONS=true
# run_local replays the cached stem and refuses one whose meta names another separator
# (audit.stems pins this model; SEPARATION_MIXBACK is unset in prod: 0).
SEPARATION_MODEL_FILENAME=vocals_mel_band_roformer.ckpt
# Speed only.
OMP_NUM_THREADS=5

# Not set in prod, so the code defaults hold: SEPARATION_MODE=always, WINDOWED_ALIGNMENT=true,
# FX_EMBEDDINGS=false.
# Prod also sets LRCLIB_PUBLISH_ENABLED=true. It is left out on purpose: run_local switches
# publishing off and refuses every lrclib / mirror request whatever the environment says.
